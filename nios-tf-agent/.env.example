# Copy to .env, fill in, then:  set -a; source .env; set +a
# Never commit the real .env file.

OLLAMA_URL=http://localhost:11434
AGENT_MODEL=llama3.1:8b
EMBED_MODEL=nomic-embed-text
AGENT_NUM_CTX=8192
AGENT_MAX_STEPS=25
AGENT_WORKSPACE=./workspace
AGENT_AUTO_APPROVE_DESTRUCTIVE=false

TERRAFORM_BIN=terraform
TERRAFORM_TIMEOUT=600
NIOS_PROVIDER_SOURCE=infobloxopen/nios
NIOS_PROVIDER_VERSION=

# Test grid only. Never point this at production.
NIOS_HOST_URL=https://your-test-grid.example.com
NIOS_USERNAME=
NIOS_PASSWORD=
